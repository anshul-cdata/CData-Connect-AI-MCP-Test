{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "connector-qa/gap.schema.json",
  "title": "Gap",
  "description": "One coverage gap. Emitted as a skeleton by scripts/compute-gaps.mjs; description and business_importance filled by the model; priority by scripts/score-gaps.mjs; final_status by scripts/credit-coverage.mjs.",
  "type": "object",
  "required": ["id", "category", "impacted", "tier", "evidence", "evidence_strength", "detected_round", "final_status"],
  "properties": {
    "id": { "type": "string", "pattern": "^GAP-\\d{3,}$" },
    "category": { "enum": ["EXPOSURE", "SCHEMA", "BUSINESS", "QUERY", "INTENT", "PROCEDURE", "RELATIONSHIP", "CUSTOMER", "BEHAVIOR"] },
    "description": { "type": ["string", "null"], "maxLength": 300 },
    "business_importance": { "enum": ["HIGH", "MEDIUM", "LOW", null] },
    "impacted": {
      "type": "object",
      "properties": {
        "objects": { "type": "array", "items": { "type": "string" } },
        "columns": { "type": "array", "items": { "type": "string" } },
        "relationships": { "type": "array", "items": { "type": "string" } },
        "patterns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tier": { "enum": ["T1", "T2", "T3", "T4"] },
    "evidence": { "type": "string" },
    "evidence_strength": { "enum": ["STRONG", "MEDIUM", "WEAK"] },
    "detected_round": { "type": "integer", "minimum": 0 },
    "priority": { "enum": ["P1", "P2", "P3", "P4", null] },
    "priority_score": { "type": ["integer", "null"] },
    "score_terms": { "type": "object" },
    "planned_tests": { "type": "array", "items": { "type": "string" } },
    "final_status": { "enum": ["OPEN", "CLOSED", "PARTIALLY_CLOSED", "FAILED", "NOT_APPLICABLE", "NOT_TESTABLE"] },
    "failed_owner": { "enum": ["owner-ai", "owner-driver", "owner-schema", null] },
    "known_production_failure": { "type": "boolean" },
    "on_standard_report": { "type": "boolean" },
    "blocks": { "type": "boolean" },
    "cost_high": { "type": "boolean" }
  }
}
